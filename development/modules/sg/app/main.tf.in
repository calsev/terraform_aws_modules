module "sg_rule" {
  source                           = "../../sg/rule_set"
  {{ sg.map_item() }}
  sg_map_internal                  = var.sg_map_internal
  sg_map_public                    = var.sg_map_public
  sg_map_private                   = var.sg_map_private
  std_map                          = var.std_map
  vpc_map                          = var.vpc_data_map
}

module "sg" {
  source = "../../sg/group"
  vpc_map = {
    (var.vpc_key_default) = merge(
      var.vpc_data_map[var.vpc_key_default],
      {
        security_group_map = module.sg_rule.data.security_group_map
      },
    )
  }
  std_map = var.std_map
}
