{{ name.var(infix=False, app_fields=False, regex=["/"]) }}

# Typically building the image will involve reading layers as well
{{ iam.policy_var_ar(access=["read", "read_write"], append="image") }}

variable "repo_map" {
  type = map(object({
    base_image                    = optional(string) # For Setting up a mirror repo
    iam_policy_json               = optional(string)
    image_tag_mirror_list = optional(list(string))
    lifecycle_rule_map   = optional(map(object({
      selection = object({
        countNumber = number
        countType   = string
        countUnit   = string
        tagStatus   = string
      }),
      action = object({
        type = string
      })
      }
    )))
    lifecycle_tag_map = optional(map(object({
      tag_max_count    = optional(number)
      tag_pattern_list = list(string)
    })))
    lifecycle_tag_max_count_default = optional(number)
    {{ name.var_item() }}
    policy_access_list      = optional(list(string))
    policy_name_append      = optional(string)
  }))
}

variable "repo_iam_policy_json_default" {
  type        = string
  default     = null
  description = "This policy will override the base policy with SIDs: LambdaGetImage"
}

variable "repo_image_tag_mirror_list_default" {
  type        = list(string)
  default     = ["latest"]
  description = "These tags will be duplicated from the base image, if both exist"
}

variable "repo_lifecycle_rule_map_default" {
  type = map(object({
    selection = object({
      countNumber = number
      countType   = string
      countUnit   = string
      tagStatus   = string
    }),
    action = object({
      type = string
    })
    }
  ))
  default = {
    1 = {
      selection = {
        countNumber = 7
        countType   = "sinceImagePushed"
        countUnit   = "days"
        tagStatus   = "untagged"
      },
      action = {
        type = "expire"
      }
    }
  }
}

variable "repo_lifecycle_tag_map_default" {
  type    = map(object({
    tag_max_count    = optional(number)
    tag_pattern_list = list(string)
  }))
  # ECR never lets a lower-priority rule expire an image that matches a higher-priority
  # rule's tags, but every rule still counts those images. So the environment tags get
  # their own ordered rules (prd is never dropped due to dev which is never dropped due to v_),
  # and version tags get a backstop. Multiple patterns in one rule must all match,
  # hence one rule per pattern.
  default = {
    2 = {
      tag_max_count    = 12
      tag_pattern_list = ["prd*"]
    }
    3 = {
      tag_max_count    = 12
      tag_pattern_list = ["stg*"]
    }
    4 = {
      tag_max_count    = 12
      tag_pattern_list = ["dev*"]
    }
    5 = {
      tag_max_count    = 90
      tag_pattern_list = ["v_*"]
    }
    6 = {
      tag_max_count    = null
      tag_pattern_list = ["*"]
    }
  }
}

variable "repo_lifecycle_tag_max_count_default" {
  type    = number
  default = 9
}

{{ std.map() }}
