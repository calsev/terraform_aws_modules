{{ name.map() }}

locals {
  l0_map = {
    for k, v in var.server_map : k => v
  }
  l1_map = {
    for k, v in local.l0_map : k => merge(v, module.name_map.data[k], {
      identifier            = v.identifier == null ? var.server_identifier_default : v.identifier
      scope_map             = v.scope_map == null ? var.server_scope_map_default : v.scope_map
      user_pool_id          = v.user_pool_id == null ? var.server_user_pool_id_default : v.user_pool_id
    })
  }
  l2_map = {
    for k, v in local.l0_map : k => {
    }
  }
  lx_map = {
    for k, _ in local.l0_map : k => merge(local.l1_map[k], local.l2_map[k])
  }
  output_data = {
    for k, v in local.lx_map : k => merge(
      {
        for k_attr, v_attr in v : k_attr => v_attr if !contains([], k_attr)
      },
      {
        id                = aws_cognito_resource_server.this_server[k].id
        scope_identifiers = aws_cognito_resource_server.this_server[k].scope_identifiers
      },
    )
  }
}
