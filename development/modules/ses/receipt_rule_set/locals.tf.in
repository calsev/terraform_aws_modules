{{ name.map() }}

locals {
  create_active_map = {
    for k, v in local.lx_map : k => v if v.active
  }
  l0_map = {
    for k, v in var.rule_set_map : k => v
  }
  l1_map = {
    for k, v in local.l0_map : k => merge(v, module.name_map.data[k], {
      active = v.active == null ? var.rule_set_active_default : v.active
    })
  }
  l2_map = {
    for k, v in local.l0_map : k => {
    }
  }
  lx_map = {
    for k, _ in local.l0_map : k => merge(local.l1_map[k], local.l2_map[k])
  }
  output_data = {
    for k, v in local.lx_map : k => merge(
      {
        for k_attr, v_attr in v : k_attr => v_attr if !contains([], k_attr)
      },
      {
        rule_set_arn  = aws_ses_receipt_rule_set.this_rule_set[k].arn
        rule_set_name = aws_ses_receipt_rule_set.this_rule_set[k].rule_set_name
      },
    )
  }
}
